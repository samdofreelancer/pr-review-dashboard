# GitHub credentials are resolved in this order: GH_TOKEN, GITHUB_TOKEN, then gh CLI.
GH_TOKEN=
GITHUB_TOKEN=

# Required only for AI-assisted reviews.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=180000

# Local service configuration. Default PORT is 0 (random free port) if unset.
PORT=4317
APP_DATA_DIR=

# Optional overrides.
AI_MAX_CONTEXT_CHARS=300000
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
