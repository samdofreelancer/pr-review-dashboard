{
  "name": "@pr-review-dashboard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --config ../vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config ../vitest.config.ts server/tests/integration --passWithNoTests",
    "test:perf": "vitest run --config ../vitest.config.ts server/tests/perf --passWithNoTests"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@octokit/graphql": "^9.0.5",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.0",
    "@pr-review-dashboard/shared": "file:../shared",
    "fastify": "^5.6.2",
    "parse-diff": "^0.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "msw": "^2.11.5",
    "tsx": "^4.20.6"
  }
}
