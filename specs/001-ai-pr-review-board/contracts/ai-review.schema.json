{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-review-dashboard.local/contracts/ai-review.schema.json",
  "title": "AI review result",
  "description": "Structured, single-shot review output. The application adds commit identity and run metadata after validation; the model must not return them. Invalid output fails the run as a whole.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "tests_missing",
    "files_reviewed",
    "files_skipped"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "comment", "request_changes"],
      "description": "Advisory only. The human reviewer chooses the GitHub event."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "tests_missing": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "files_reviewed": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "files_skipped": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/skipped"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "side",
        "line",
        "severity",
        "category",
        "title",
        "explanation",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "side": {
          "type": "string",
          "enum": ["LEFT", "RIGHT"]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "nit"]
        },
        "category": {
          "type": "string",
          "enum": [
            "bug",
            "security",
            "performance",
            "concurrency",
            "error_handling",
            "api_contract",
            "tests",
            "maintainability",
            "style"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quoted_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Code expected at the anchor; used only for re-anchoring and never published."
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Optional replacement for exactly one RIGHT-side line."
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reason": {
          "type": "string",
          "enum": [
            "binary",
            "too_large",
            "excluded",
            "symlink",
            "submodule",
            "generated",
            "unreadable"
          ]
        }
      }
    }
  }
}
