{
  "name": "pr-review-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI-assisted GitHub pull request review board.",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace @pr-review-dashboard/server\" \"npm run dev --workspace @pr-review-dashboard/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @pr-review-dashboard/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @pr-review-dashboard/server",
    "test:e2e": "playwright test",
    "test:perf": "npm run test:perf --workspace @pr-review-dashboard/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
